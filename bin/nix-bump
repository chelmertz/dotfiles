#!/bin/sh
set -e

DOTFILES=~/code/github/chelmertz/dotfiles

# The bump itself dirties nix/flake.lock, so both steps would warn about the
# dirty tree; home-manager takes the setting rather than the --no-warn-dirty flag.
nix flake update --no-warn-dirty --flake "$DOTFILES/nix" &&
    home-manager --option warn-dirty false switch

# Keep only the 3 most recent generations, then GC unreferenced store paths
nix-env --delete-generations +3
nix-env --profile ~/.local/state/nix/profiles/home-manager --delete-generations +3
nix-collect-garbage

if git -C "$DOTFILES" diff --quiet nix/flake.lock; then
    exit 0
fi

# Commit only flake.lock, regardless of what else is staged.
# "git commit [--] <pathspec>" commits the on-disk content of that file
# in a new commit without touching the rest of the index.
git -C "$DOTFILES" commit nix/flake.lock -m "nix: bump flakes"
