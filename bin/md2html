#!/usr/bin/env bash

# md2html - convert a markdown file (with mermaid support) to a single HTML file
# Requires: pandoc
#
# Usage:
#   md2html file.md          - convert file, output HTML to stdout
#   cat file.md | md2html    - read from stdin, output HTML to stdout

set -euo pipefail

# Create temporary files
mermaid_filter=$(mktemp --suffix=.lua)
toc_template=$(mktemp --suffix=.html)
title_filter=$(mktemp --suffix=.lua)
title_template=$(mktemp --suffix=.html)
trap 'rm -f "$mermaid_filter" "$toc_template" "$title_filter" "$title_template"' EXIT

echo '$toc$' > "$toc_template"
echo '$title$' > "$title_template"

# Pick the <title>: YAML frontmatter title, else the first heading. Flattened to a
# plain string so inline markup (code spans, emphasis) doesn't end up as literal
# tags in the tab label, and so the HTML writer escapes it.
cat > "$title_filter" <<'FILTER'
function Pandoc(doc)
  local title = doc.meta.title
  if not title then
    for _, block in ipairs(doc.blocks) do
      if block.t == "Header" then
        title = block.content
        break
      end
    end
  end
  doc.meta = pandoc.Meta({ title = pandoc.MetaString(pandoc.utils.stringify(title or "")) })
  return doc
end
FILTER

# Mermaid is rendered client-side via a CDN import (see the <script type="module">
# below), so diagrams need network at view time. Future: render to static SVG at
# build time and inline it here -> fully self-contained, offline, no CDN, no
# securityLevel:'loose'. Candidate tool (headless Rust mermaid renderer):
#   https://github.com/Latias94/merman
# Revisit after 2026-09-12: check maturity/parity + whether it's nix-packaged. Keep
# the CDN path as a per-block fallback for diagram types merman can't render.
cat > "$mermaid_filter" <<'FILTER'
function CodeBlock(block)
  if block.classes[1] == "mermaid" then
    local text = block.text
    -- Strip YAML frontmatter (everything between --- and ---) from start of block
    text = text:gsub("^%-%-%-.-%-%-%-\n", "")
    return pandoc.RawBlock("html", "<pre class=\"mermaid\">\n" .. text .. "\n</pre>")
  end
end
FILTER

# Read input: file argument or stdin
if [ $# -ge 1 ] && [ -f "$1" ]; then
	input_file="$1"
	md_content=$(cat "$input_file")
else
	md_content=$(cat)
fi

# Embed font as base64 data URI — file:// refs are blocked when the HTML is served over http://
# Only the regular weight is embedded; the browser synthesizes bold.
font_regular="$HOME/.local/share/fonts/Go/Go-Mono.ttf"
font_regular_src='local("Go Mono")'
if [ -f "$font_regular" ]; then
	font_regular_src="url(\"data:font/ttf;base64,$(base64 -w0 "$font_regular")\") format(\"truetype\")"
fi

# Bake the desktop's color scheme into the document. Firefox is configured with
# layout.css.prefers-color-scheme.content-override=1, which forces every page to
# report `prefers-color-scheme: light`, so the media query alone never fires. The
# data-theme attribute wins over it; the media query stays as a fallback for
# browsers that report honestly.
case "$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null)" in
	*prefer-dark*) system_theme="dark" ;;
	*)             system_theme="light" ;;
esac

# Document title, for telling several open previews apart in the tab bar. The
# filename is the fallback for a headingless document; a piped-in one has neither.
doc_title=$(echo "$md_content" | pandoc -f markdown+fenced_code_attributes+lists_without_preceding_blankline -t html --template="$title_template" --lua-filter "$title_filter" 2>/dev/null)
if [ -z "$doc_title" ]; then
	doc_title=$(basename "${input_file:-md2html}")
fi

# Generate TOC
toc_html=$(echo "$md_content" | pandoc -f markdown+fenced_code_attributes+lists_without_preceding_blankline -t html --toc --template="$toc_template" 2>/dev/null)

# Convert markdown to HTML fragment
body_html=$(echo "$md_content" | pandoc -f markdown+fenced_code_attributes+lists_without_preceding_blankline -t html --highlight-style=kate --lua-filter "$mermaid_filter" 2>/dev/null)

# Only render the ToC aside (and enable the sidebar grid layout) when there's something to show.
if printf '%s' "$toc_html" | grep -q '<a '; then
	toc_aside="<aside class=\"toc-wrap\"><nav id=\"toc\">${toc_html}</nav></aside>"
	body_class=' class="has-toc"'
else
	toc_aside=""
	body_class=""
fi

cat <<HTMLEOF
<!DOCTYPE html>
<html lang="en" data-theme="$system_theme">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>$doc_title</title>
<script>
// Applied before the stylesheet so a remembered choice never flashes the other
// scheme. Scope is one preview file, not all of them: Firefox's
// privacy.file_unique_origin gives every file:// document its own origin, so
// localStorage does not carry across cached previews — the data-theme baked in
// above is what makes a *new* preview follow the desktop. The stored value
// carries the desktop scheme it was overriding, so toggling the desktop
// (bin/color-scheme) drops a stale override instead of pinning it forever.
(function () {
  try {
    var parts = (localStorage.getItem('md2html-theme') || '').split('|');
    if ((parts[0] === 'dark' || parts[0] === 'light') && parts[1] === '$system_theme') {
      document.documentElement.dataset.theme = parts[0];
    }
  } catch (e) {}
})();
</script>
<script type="module">
  try {
    const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
    const blocks = Array.from(document.querySelectorAll('pre.mermaid'));
    const sources = blocks.map(b => b.textContent);
    const render = async () => {
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'loose',
        theme: document.documentElement.dataset.theme === 'dark' ? 'dark' : 'base',
      });
      blocks.forEach((b, i) => {
        b.textContent = sources[i];
        b.removeAttribute('data-processed');
      });
      if (blocks.length) await mermaid.run({ nodes: blocks });
    };
    await render();
    window.addEventListener('md2html:theme', render);
  } catch (e) {
    console.warn('Mermaid failed:', e);
  }
</script>
<style>
@font-face {
  font-family: "Go Mono";
  src: $font_regular_src;
  font-weight: normal;
  font-style: normal;
}
:root, :root[data-theme="light"] {
  --bg: #fff; --fg: #222; --muted: #666; --border: #ccc; --accent: #444;
  --code-bg: #ececec;
  /* Saturation/lightness for the enum row tints; only the hue varies per value. */
  --tint-s: 60%; --tint-l: 91%;
}
@media (prefers-color-scheme: dark) {
  :root { --bg: #1a1a1a; --fg: #e0e0e0; --muted: #888; --border: #444; --accent: #aaa; --code-bg: #2a2a2a;
          --tint-s: 35%; --tint-l: 22%; }
}
/* Last, and one specificity step above the media query, so the baked-in
   data-theme beats both the light default and a lying prefers-color-scheme. */
:root[data-theme="dark"] {
  --bg: #1a1a1a; --fg: #e0e0e0; --muted: #888; --border: #444; --accent: #aaa; --code-bg: #2a2a2a;
  --tint-s: 35%; --tint-l: 22%;
}
* { box-sizing: border-box; }
body {
  font-family: "Noto Serif", Georgia, "Times New Roman", serif;
  font-size: 1.15rem;
  margin: 0;
  padding: 2rem 1rem;
  background: var(--bg);
  color: var(--fg);
  line-height: 1.5;
}
main { max-width: 70ch; margin: 0 auto; min-width: 0; }
:is(h1, h2, h3, h4, h5, h6)[id] { scroll-margin-top: 1rem; }
a { color: var(--accent); }
code, pre { font-family: "Go Mono", monospace; }
blockquote {
  margin: 1rem 0;
  padding: 0.5rem 1rem;
  border-left: 3px solid var(--muted);
  color: var(--muted);
  font-style: italic;
}
blockquote > *:first-child { margin-top: 0; }
blockquote > *:last-child { margin-bottom: 0; }
pre { overflow-x: auto; padding: 0.5rem; }
code {
  font-size: 0.9em;
  background: color-mix(in srgb, var(--border) 35%, transparent);
  padding: 0.1em 0.3em;
  border-radius: 3px;
}
pre code { background: none; padding: 0; border-radius: 0; }
img { max-width: 100%; }
pre.mermaid {
  background: transparent;
  width: min(1500px, calc(100vw - 4rem));
  margin-left: calc(50% - min(750px, 50vw - 2rem));
}
pre.mermaid svg {
  width: 100%;
  height: auto;
}
@media (max-width: 1599px) {
  pre.mermaid { overflow-x: auto; }
}
/* Pandoc syntax highlighting (monochrome) */
pre > code.sourceCode { white-space: pre; position: relative; }
pre > code.sourceCode > span { line-height: 1.25; }
pre > code.sourceCode > span:empty { height: 1.2em; }
code.sourceCode > span { color: inherit; text-decoration: inherit; }
div.sourceCode { margin: 1em 0; background: var(--code-bg); border: 1px solid var(--border); }
pre.sourceCode { margin: 0; }
@media screen { div.sourceCode { overflow: auto; } }
code span.al { font-weight: bold; }
code span.an { font-style: italic; }
code span.cf { font-weight: bold; }
code span.co { font-style: italic; }
code span.cv { font-style: italic; }
code span.do { font-style: italic; }
code span.dt { text-decoration: underline; }
code span.er { font-weight: bold; }
code span.in { font-style: italic; }
code span.kw { font-weight: bold; }
code span.pp { font-weight: bold; }
code span.wa { font-style: italic; }
aside.toc-wrap { min-width: 0; }
nav#toc {
  margin: 0 auto 2rem;
  padding: 1rem;
  border: 1px solid var(--border);
  max-width: 70ch;
  font-size: 0.95rem;
}
nav#toc > ul { margin: 0; padding-left: 1.2em; }
nav#toc ul { list-style: none; padding-left: 1em; }
nav#toc li { margin: 0.2em 0; }
nav#toc a {
  display: inline-block;
  text-decoration: none;
  line-height: 1.3;
  overflow-wrap: anywhere;
  border-left: 2px solid transparent;
  padding-left: 0.4em;
  margin-left: -0.4em;
}
nav#toc a.active {
  font-weight: bold;
  color: var(--fg);
  border-left-color: var(--accent);
}

/* Sidebar layout: only when a ToC exists AND viewport is wide enough.
   Two-column grid centered in the viewport so wide monitors don't get stretched. */
@media (min-width: 70rem) {
  body.has-toc {
    display: grid;
    grid-template-columns: minmax(0, 18rem) minmax(0, 70ch);
    column-gap: 2rem;
    justify-content: center;
  }
  body.has-toc aside.toc-wrap { grid-column: 1; min-width: 0; }
  body.has-toc main { grid-column: 2; margin: 0; max-width: none; }
  body.has-toc nav#toc {
    position: sticky;
    top: 1rem;
    margin: 0;
    max-width: none;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
  }
}
#theme-toggle {
  position: fixed;
  top: 0.75rem;
  right: 0.75rem;
  z-index: 1;
  font: inherit;
  font-size: 1rem;
  line-height: 1;
