  border: 1px solid var(--border);
  padding: 0.4rem 0.6rem;
  vertical-align: top;
  text-align: left;
}
th { background: var(--border); }
tbody tr:nth-child(even) td { background: color-mix(in srgb, var(--border) 25%, transparent); }
/* Sort/filter controls, added by script to tables big enough to warrant them.
   Filtered-out rows leave the DOM rather than being hidden, so the zebra
   striping above stays correct without a second class-based rule. */
table.interactive thead tr:first-child th {
  cursor: pointer;
  user-select: none;
  white-space: nowrap;
}
table.interactive thead tr:first-child th:hover { color: var(--accent); }
