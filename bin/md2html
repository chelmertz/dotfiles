}
.table-count { color: var(--muted); font-size: 0.85rem; margin: 1rem 0 -0.75rem; }
.table-count:empty { display: none; }
/* Sorting by a column whose values repeat like an enum tints each row by that
   value, so the sorted groups read as blocks. One class more specific than the
   zebra rule above, which deliberately loses — stripes inside a colour block
   are noise. --row-hue is set inline per row by the script. */
table.interactive tbody tr.tinted td {
  background: hsl(var(--row-hue) var(--tint-s) var(--tint-l));
}
</style>
</head>
<body${body_class}>
<button id="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode"></button>
${toc_aside}
<main>
$body_html
</main>
<script>
(function () {
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle');
  const label = () => { btn.textContent = root.dataset.theme === 'dark' ? '☀' : '☾'; };
  btn.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('md2html-theme', next + '|' + '$system_theme'); } catch (e) {}
    label();
    window.dispatchEvent(new Event('md2html:theme'));
  });
  label();
})();
</script>
<script>
(function () {
  const tocLinks = document.querySelectorAll('nav#toc a[href^="#"]');
  if (!tocLinks.length) return;
  const linkById = new Map();
  tocLinks.forEach(a => {
    try {
      const id = decodeURIComponent(a.getAttribute('href').slice(1));
      if (id) linkById.set(id, a);
    } catch (_) {}
  });
  const targets = [];
  linkById.forEach((_, id) => {
    const el = document.getElementById(id);
    if (el) targets.push(el);
  });
  if (!targets.length) return;

  // Normalize to document order so we can short-circuit the scan.
  targets.sort((a, b) =>
    (a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING) ? -1 : 1);

  const toc = document.querySelector('nav#toc');
  // Scroll only inside the ToC's own overflow box — never the page.
  // In stacked (narrow) mode the nav has no internal scroll, so we no-op.
  const keepLinkVisibleInToc = (link) => {
    if (!toc || toc.scrollHeight <= toc.clientHeight) return;
    const lr = link.getBoundingClientRect();
    const tr = toc.getBoundingClientRect();
    if (lr.top < tr.top) toc.scrollTop += lr.top - tr.top - 4;
    else if (lr.bottom > tr.bottom) toc.scrollTop += lr.bottom - tr.bottom + 4;
  };

  let active = null;
  const update = () => {
    const line = Math.max(80, window.innerHeight * 0.25);
    let candidate = targets[0];
    for (const t of targets) {
      if (t.getBoundingClientRect().top <= line) candidate = t;
      else break;
    }
    const next = linkById.get(candidate.id);
    if (next === active) return;
    if (active) active.classList.remove('active');
    if (next) {
      next.classList.add('active');
      keepLinkVisibleInToc(next);
    }
    active = next;
  };

  let ticking = false;
  const schedule = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => { ticking = false; update(); });
  };
  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule);
  update();
})();
</script>
<script>
(function () {
  // Click a header to sort (asc, desc, back to document order); type in the row
  // beneath it to filter that column. No pagination — a table sized for a
  // markdown document is meant to be read whole.
  // Only tables past this length get controls; a filter row on three rows is noise.
  const MIN_ROWS = 8;
  // A column counts as an enum when it has at least two distinct values, no more
  // than this many, and each one repeats on average — a column of unique ids has
  // no groups worth colouring.
  const MAX_ENUM_VALUES = 8;
  // Hues spread far enough apart to tell adjacent blocks apart; cycled if a
  // column has more values than this. Deliberately not red/green pairs first,
  // which would read as pass/fail on columns that mean nothing of the sort.
  const HUES = [210, 145, 35, 280, 190, 320, 60, 0];

  const cellText = (row, i) => row.cells[i].textContent.trim();
  // Returns null for anything not wholly a number, which also drives the
  // numeric-vs-text sort decision per column.
  const numberOf = (v) => {
    const cleaned = v.replace(/[\s,%]/g, '');
    if (cleaned === '') return null;
    const n = Number(cleaned);
    return isFinite(n) ? n : null;
  };

  document.querySelectorAll('main table').forEach((table) => {
    const head = table.tHead;
    const body = table.tBodies[0];
    if (!head || !body || head.rows.length !== 1) return;

    const headCells = Array.from(head.rows[0].cells);
    const rows = Array.from(body.rows);
    if (rows.length < MIN_ROWS) return;
    // Bail on anything that is not a plain grid — merged cells would scramble.
    if (rows.some((r) => r.cells.length !== headCells.length)) return;
    if (headCells.concat(rows.flatMap((r) => Array.from(r.cells)))
        .some((c) => c.colSpan > 1 || c.rowSpan > 1)) return;

    const labels = headCells.map((c) => c.textContent.trim());
    const isNumeric = headCells.map((_, i) => {
      const values = rows.map((r) => cellText(r, i)).filter((v) => v !== '');
      return values.length > 0 && values.every((v) => numberOf(v) !== null);
    });

    // Value -> hue per column, or null where the column is not enum-like. Built
    // once from document order so a value keeps its colour in either direction.
    const enumHues = headCells.map((_, i) => {
      const order = new Map();
      rows.forEach((r) => {
        const v = cellText(r, i);
        if (!order.has(v)) order.set(v, order.size);
      });
      if (order.size < 2 || order.size > MAX_ENUM_VALUES) return null;
      if (order.size * 2 > rows.length) return null;
      const hues = new Map();
      order.forEach((idx, v) => hues.set(v, HUES[idx % HUES.length]));
      return hues;
    });

    table.classList.add('interactive');
    const filters = headCells.map(() => '');
    let sortCol = -1;
    let dir = 0;

    const count = document.createElement('div');
    count.className = 'table-count';
    count.setAttribute('aria-live', 'polite');
    table.parentNode.insertBefore(count, table);

    const render = () => {
      let out = rows.filter((r) =>
        filters.every((f, i) => !f || cellText(r, i).toLowerCase().includes(f)));
      if (dir !== 0) {
        const i = sortCol;
        out = out.slice().sort((a, b) => {
          const av = cellText(a, i);
          const bv = cellText(b, i);
          let c;
          if (isNumeric[i]) {
            const an = numberOf(av);
            const bn = numberOf(bv);
            // Blanks sink to the bottom in both directions rather than sorting.
            if (an === null || bn === null) {
              if (an === null && bn === null) return 0;
              return an === null ? 1 : -1;
            }
            c = an - bn;
          } else {
            c = av.localeCompare(bv, undefined, { numeric: true, sensitivity: 'base' });
          }
          return c * dir;
        });
      }
      // Filtered-out rows leave the DOM instead of being hidden, so the
      // nth-child zebra striping keeps alternating over what is on screen.
      body.replaceChildren(...out);
      count.textContent = out.length === rows.length
        ? '' : out.length + ' of ' + rows.length + ' rows';
    };

    // Tints follow the sorted column only, so clicking back to document order
    // clears them along with the sort.
    const retint = () => {
      const hues = dir === 0 ? null : enumHues[sortCol];
      rows.forEach((r) => {
        const hue = hues ? hues.get(cellText(r, sortCol)) : undefined;
        if (hue === undefined) {
          r.classList.remove('tinted');
          r.style.removeProperty('--row-hue');
        } else {
          r.classList.add('tinted');
          r.style.setProperty('--row-hue', hue + 'deg');
        }
      });
    };

    headCells.forEach((th, i) => {
      const arrow = document.createElement('span');
      arrow.className = 'sort-arrow';
      th.appendChild(arrow);
      th.tabIndex = 0;
      th.setAttribute('role', 'button');
      th.setAttribute('aria-sort', 'none');
      const toggle = () => {
        if (sortCol === i) dir = dir === 1 ? -1 : dir === -1 ? 0 : 1;
        else { sortCol = i; dir = 1; }
        if (dir === 0) sortCol = -1;
        retint();
        headCells.forEach((h, j) => {
          const on = j === sortCol && dir !== 0;
          h.querySelector('.sort-arrow').textContent = on ? (dir === 1 ? ' ▲' : ' ▼') : '';
          h.setAttribute('aria-sort', on ? (dir === 1 ? 'ascending' : 'descending') : 'none');
        });
        render();
      };
      th.addEventListener('click', toggle);
      th.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
      });
    });

    const filterRow = head.insertRow(-1);
    filterRow.className = 'filter-row';
    headCells.forEach((_, i) => {
      const input = document.createElement('input');
      input.type = 'search';
      input.size = 6; // keeps auto table layout from widening the column
      input.placeholder = 'filter';
      input.setAttribute('aria-label', 'Filter by ' + (labels[i] || 'column ' + (i + 1)));
      input.addEventListener('input', () => {
        filters[i] = input.value.trim().toLowerCase();
        render();
      });
      filterRow.insertCell(-1).appendChild(input);
    });
  });
})();
</script>
</body>
</html>
HTMLEOF
