#!/usr/bin/env python3
"""Keep wee-slack's Slack sessions valid, one per workspace.

wee-slack takes a comma-separated list of "xoxc-...:d=xoxd-..." tokens, one per
workspace. The xoxd cookie is long-lived and shared by every workspace the
Slack desktop app is signed into; the xoxc tokens rotate, and the desktop app
rewrites current ones into its leveldb (plaintext) whenever it runs.

The configured workspaces are the union of what plugins.conf already holds and
every workspace with a valid token on disk, so signing into a new workspace in
the desktop app adds it here too. Per workspace (matched by the team id that
prefixes each xoxc token) the stored token is kept if auth.test accepts it,
otherwise a fresh one from disk is used. Only if the cookie itself has rotated
is it decrypted from Slack's cookie store (Chromium v11: AES-128-CBC, key in
the login keyring).

The happy path is one auth.test per workspace and then silence. The slow path
(cookie decrypt) and any workspace left unresolved fire a desktop notification
and a stderr line. Booting Slack to refresh stale on-disk data is deliberately
NOT automatic; the notification says to open Slack once instead.

Usage: slack-session-ensure [--from-launch] [--quiet]
  --from-launch  wait up to 30s for a weechat fifo (the wee entrypoint forks
                 this before weechat is up)
  --quiet        suppress stderr lines (notifications stay)
"""
import glob
import hashlib
import json
import os
import re
import subprocess
import sys
import time
import urllib.request

HOME = os.path.expanduser("~")
PLUGINS_CONF = os.path.join(
    os.environ.get("WEECHAT_HOME", os.path.join(HOME, ".config/weechat")), "plugins.conf"
)
SLACK_DIR = os.path.join(HOME, ".config/Slack")
RUNTIME = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid()), "weechat"
)
# plugins.conf stores the option under its var section without the
# "plugins.var." prefix that /set needs.
TOKEN_KEY = "python.slack.slack_api_token"
TOKEN_OPT = "plugins.var." + TOKEN_KEY

ARGS = set(sys.argv[1:])
unknown = ARGS - {"--from-launch", "--quiet"}
if unknown:
    sys.exit("slack-session-ensure: unknown args: %s" % " ".join(sorted(unknown)))


def note(msg):
    subprocess.run(["notify-send", "-u", "normal", "Slack (wee)", msg], check=False)


def warn(msg):
    if "--quiet" not in ARGS:
        print("slack-session-ensure: " + msg, file=sys.stderr)


def team_of(xoxc):
    # xoxc-<team>-...: the cookie covers every signed-in workspace, so
    # auth.test says ok for any of them; the team id keeps them apart.
    return xoxc.split("-")[1]


def auth_ok(xoxc, xoxd):
    req = urllib.request.Request(
        "https://slack.com/api/auth.test",
        headers={"Authorization": "Bearer " + xoxc, "Cookie": "d=" + xoxd},
    )
    try:
        with urllib.request.urlopen(req, timeout=12) as resp:
            return bool(json.load(resp).get("ok"))
    except (OSError, ValueError):
        return False


def stored_tokens():
    """[(xoxc, xoxd)] from plugins.conf; empty on a fresh machine."""
    try:
        text = open(PLUGINS_CONF).read()
    except OSError:
        return []
    # Matches only a real token list, so the identically-prefixed help text in
    # the [desc] section is ignored.
    m = re.search(r'^%s = "(xoxc[^"]*)"$' % re.escape(TOKEN_KEY), text, re.M)
    if not m:
        return []
    pairs = []
    for item in m.group(1).split(","):
        if ":d=" in item:
            xoxc, xoxd = item.split(":d=", 1)
            pairs.append((xoxc, xoxd))
    return pairs


def disk_tokens():
    """Every xoxc token in Slack desktop's leveldb, grouped by team id."""
    by_team = {}
    for f in glob.glob(os.path.join(SLACK_DIR, "Local Storage/leveldb/*")):
        try:
            data = open(f, "rb").read()
        except OSError:
            continue
        for t in re.findall(rb"xoxc-[0-9A-Za-z-]+", data):
            t = t.decode()
            by_team.setdefault(team_of(t), [])
            if t not in by_team[team_of(t)]:
                by_team[team_of(t)].append(t)
    return by_team


def decrypt_cookie():
    """The `d` cookie from Slack's cookie store, or None."""
    try:
        pw = subprocess.run(
            ["secret-tool", "lookup", "application", "Slack"],
            capture_output=True, text=True, check=True,
        ).stdout
        if not pw:
            return None
        key = hashlib.pbkdf2_hmac("sha1", pw.encode(), b"saltysalt", 1, 16).hex()
        blob = subprocess.run(
            ["sqlite3", "-readonly", "file:%s?immutable=1" % os.path.join(SLACK_DIR, "Cookies"),
             "select hex(encrypted_value) from cookies where host_key='.slack.com' and name='d'"],
            capture_output=True, text=True, check=True,
        ).stdout.strip()
        if not blob:
            return None
        # Strip the 3-byte "v11" scheme prefix, AES-128-CBC with a fixed IV of
        # 16 spaces, then drop the 32-byte SHA-256 domain-hash prefix.
        plain = subprocess.run(
            ["openssl", "enc", "-d", "-aes-128-cbc", "-K", key,
             "-iv", "20202020202020202020202020202020"],
            input=bytes.fromhex(blob[6:]), capture_output=True, check=True,
        ).stdout[32:].decode(errors="replace")
    except (OSError, subprocess.CalledProcessError, ValueError):
        return None
    return plain if plain.startswith("xoxd-") else None


def resolve(teams, stored, disk, cookie):
    """{team: xoxc} for every team a valid token was found for."""
    found = {}
    for team in teams:
        candidates = [x for x, _ in stored if team_of(x) == team] + disk.get(team, [])
        for xoxc in candidates:
            if auth_ok(xoxc, cookie):
                found[team] = xoxc
                break
    return found


def find_fifo(tries):
    for _ in range(tries):
        fifos = [f for f in glob.glob(os.path.join(RUNTIME, "weechat_fifo_*"))]
        if fifos:
            return max(fifos, key=os.path.getmtime)
        time.sleep(1)
    return None


def apply(value):
    """Push into the running weechat; /save persists it for cold starts."""
    fifo = find_fifo(30 if "--from-launch" in ARGS else 1)
    if not fifo:
        return False
    # A fifo whose weechat died has no reader and open() would block forever;
    # O_NONBLOCK fails fast instead.
    try:
        fd = os.open(fifo, os.O_WRONLY | os.O_NONBLOCK)
    except OSError:
        return False
    with os.fdopen(fd, "w") as f:
        f.write("*/set %s %s\n*/save\n" % (TOKEN_OPT, value))
    time.sleep(1)
    with open(fifo, "w") as f:
        f.write("*/python reload slack\n")
    return True


def main():
    stored = stored_tokens()
    cookie = stored[0][1] if stored else None
    disk = disk_tokens()

    # Fast path: every stored token works and disk knows no other workspace.
    if cookie and all(auth_ok(x, cookie) for x, _ in stored):
        extra = set(disk) - {team_of(x) for x, _ in stored}
        if not extra or not resolve(extra, [], disk, cookie):
            return 0

    teams = list(dict.fromkeys([team_of(x) for x, _ in stored] + list(disk)))
    found = resolve(teams, stored, disk, cookie) if cookie else {}

    # Slow path: the cookie rotated (or none stored) and some stored team is
    # now unresolved -> decrypt a fresh cookie and retry.
    stored_teams = {team_of(x) for x, _ in stored}
    if not cookie or stored_teams - set(found):
        warn("Slack cookie invalid or missing; decrypting a fresh one")
        note("Refreshing Slack session…")
        fresh = decrypt_cookie()
        if fresh:
            cookie = fresh
            found = resolve(teams, stored, disk, cookie)

    if not found:
        warn("no valid Slack session; open Slack desktop once, then /python reload slack")
        note("Slack session expired. Open Slack desktop once to refresh.")
        return 1
    missing = stored_teams - set(found)
    if missing:
        warn("no valid token for team(s) %s; open Slack desktop once" % ", ".join(sorted(missing)))
        note("Some Slack workspaces need a refresh. Open Slack desktop once.")

    value = ",".join("%s:d=%s" % (found[t], cookie) for t in teams if t in found)
    current = ",".join("%s:d=%s" % p for p in stored)
    if value != current and not apply(value):
        warn("no running weechat to update")
    return 0


if __name__ == "__main__":
    sys.exit(main())
