#!/usr/bin/env bash
set -euo pipefail

PROM_DIR="$HOME/.local/share/prometheus/textfile"

# Failed systemd user units — per-unit metric + journal snippet file
tmpfile="$PROM_DIR/systemd_failed.$$.prom.tmp"
journal_file="$PROM_DIR/systemd_failed_journal.txt"
cat > "$tmpfile" <<EOF
# HELP systemd_user_unit_failed 1 if the systemd user unit is in failed state
# TYPE systemd_user_unit_failed gauge
EOF

failed_units=$(systemctl --user --failed --no-legend --plain | awk '{print $1}')
> "$journal_file"
for unit in $failed_units; do
  echo "systemd_user_unit_failed{unit=\"$unit\"} 1" >> "$tmpfile"
  echo "=== $unit ===" >> "$journal_file"
  journalctl --user -u "$unit" -n 5 --no-pager 2>/dev/null >> "$journal_file" || true
  echo >> "$journal_file"
done

if [ -z "$failed_units" ]; then
  echo "systemd_user_unit_failed{unit=\"\"} 0" >> "$tmpfile"
fi
mv "$tmpfile" "$PROM_DIR/systemd_failed.prom"

# Filesystem usage per mount point (percentage used)
tmpfile="$PROM_DIR/filesystem.$$.prom.tmp"
cat > "$tmpfile" <<EOF
# HELP filesystem_used_percent Percentage of filesystem used
# TYPE filesystem_used_percent gauge
EOF
df --output=target,pcent -x tmpfs -x devtmpfs -x efivarfs -x squashfs | tail -n +2 | while read -r mount pct; do
  pct="${pct%%%}"
  echo "filesystem_used_percent{mountpoint=\"$mount\"} $pct" >> "$tmpfile"
done
mv "$tmpfile" "$PROM_DIR/filesystem.prom"

# Credential health. A systemd unit being active says nothing about whether the
# thing inside it can authenticate: the tau migration had dropbox running
# happily unlinked and elly running happily with no token, both with
# systemd_user_unit_failed at 0. These probe the credential itself. Each is
# wrapped so a hang or a missing binary reports 0 rather than killing the run.
tmpfile="$PROM_DIR/credentials.$$.prom.tmp"
cat > "$tmpfile" <<HDR
# HELP credential_ok 1 if the service can authenticate, 0 if it needs a login
# TYPE credential_ok gauge
HDR

probe() { # name, command...
  local name="$1"; shift
  if timeout 20 "$@" >/dev/null 2>&1; then
    echo "credential_ok{service=\"$name\"} 1" >> "$tmpfile"
  else
    echo "credential_ok{service=\"$name\"} 0" >> "$tmpfile"
  fi
}

probe gh gh auth status

# elly keeps its personal access token in a `pat` table; empty means it fell
# back to setup mode and is showing nobody's pull requests.
elly_db="$HOME/.local/share/elly/elly.db"
if [ -f "$elly_db" ] && [ "$(timeout 20 sqlite3 "$elly_db" 'select count(*) from pat;' 2>/dev/null || echo 0)" -ge 1 ]; then
  echo 'credential_ok{service="elly"} 1' >> "$tmpfile"
else
  echo 'credential_ok{service="elly"} 0' >> "$tmpfile"
fi

# `dropbox status` is still not the probe, though dropbox-cli now provides it
# for real. It reports sync state, not whether an account is attached, and it
# prints a bare "Connecting..." for the first seconds after the daemon starts,
# which a probe would read as failure. The daemon creates instance1/sync only
# once an account is attached, so test for that instead.
if [ -d "$HOME/.dropbox/instance1/sync" ]; then
  echo 'credential_ok{service="dropbox"} 1' >> "$tmpfile"
else
  echo 'credential_ok{service="dropbox"} 0' >> "$tmpfile"
fi

mv "$tmpfile" "$PROM_DIR/credentials.prom"

# Unexpected TCP listeners. The breach that prompted this and the
# domain-exporter publish looked identical from outside: a port on a routable
# address that nobody meant to open. networking.firewall never sees docker's
# published ports, so a rule in the config is not evidence a port is shut —
# only looking is. The ports below are the deliberate ones; anything else is
# counted and named in the companion file.
allowed_tcp=(22 17500 27036)
tmpfile="$PROM_DIR/listeners.$$.prom.tmp"
listener_file="$PROM_DIR/listeners_unexpected.txt"
cat > "$tmpfile" <<EOF
# HELP listening_sockets_unexpected TCP listeners on a non-loopback address whose port is not declared
# TYPE listening_sockets_unexpected gauge
EOF
> "$listener_file"
unexpected=0
while read -r addr proc; do
  [ -n "$addr" ] || continue
  port="${addr##*:}"
  case " ${allowed_tcp[*]} " in
    *" $port "*) continue ;;
  esac
  echo "$addr $proc" >> "$listener_file"
  unexpected=$((unexpected + 1))
done < <(ss -Htlnp 2>/dev/null | awk '{print $4, $6}' | grep -vE '^(127\.|\[::1\])' || true)
echo "listening_sockets_unexpected $unexpected" >> "$tmpfile"
mv "$tmpfile" "$PROM_DIR/listeners.prom"
