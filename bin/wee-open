#!/usr/bin/env python3
"""Open a wee:// link in the running wee: the xdg handler for wee://.

Usage: wee-open wee://<team>.slack.com/archives/<channel>/p<ts>[?thread_ts=…]

The message menu's L copies these for notes: a Slack message link with the
scheme swapped, so clicking one in Obsidian lands in wee rather than the
browser. The link goes to wee-slack's /slack openlink through weechat's fifo
and i3 focuses the wee window. With no wee running it only says so: the
browser would hand the link on to the Slack app.
"""

import glob
import os
import re
import subprocess
import sys

# Strict, because the link reaches weechat's command line: nothing in it may
# end the command or start another.
LINK = re.compile(
    r"wee://([a-z0-9-]+\.slack\.com/archives/[A-Z0-9]+/p\d{16}"
    r"(?:\?thread_ts=\d+\.\d+(?:&cid=[A-Z0-9]+)?)?)$"
)
RUNTIME = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid()), "weechat"
)


def send(command):
    """Write to the newest fifo with a weechat reading it."""
    fifos = glob.glob(os.path.join(RUNTIME, "weechat_fifo_*"))
    for fifo in sorted(fifos, key=os.path.getmtime, reverse=True):
        # A fifo whose weechat died has no reader and open() would block
        # forever; O_NONBLOCK fails fast instead.
        try:
            fd = os.open(fifo, os.O_WRONLY | os.O_NONBLOCK)
        except OSError:
            continue
        with os.fdopen(fd, "w") as f:
            f.write(command + "\n")
        return True
    return False


def main(argv):
    match = LINK.match(argv[1] if len(argv) > 1 else "")
    if not match:
        subprocess.run(["notify-send", "wee-open", "not a wee link: %s" % argv[1:]])
        return 1
    url = "https://" + match.group(1)
    if not send("*/slack openlink " + url):
        subprocess.run(["notify-send", "wee-open", "wee is not running: F9, then the link again"])
        return 1
    subprocess.run(["i3-msg", "-q", '[class="^org\\.weechat\\.wee$"] focus'])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
