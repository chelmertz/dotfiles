#!/usr/bin/env python3
"""PreToolUse hook (matcher: Bash): refuse heavy builds, linters and test
runners that are not wrapped in `capped`.

On 2026-11-20 another session's eslint run (three node processes at 300% CPU)
landed while Firefox paged memory back in from zram: CPU pressure hit 60%,
typing lagged and a new Claude session took seconds to open. The CLAUDE.md rule
named only Rust, Go and JVM builds, and a rule nothing enforces is one a
session forgets. `capped` puts the command in a cgroup with a CPU quota, a
memory limit that kills and E-core affinity, so the desktop stays usable.

Blocked:
    npx eslint .
    npm run lint          (also test, build, type-check, coverage, compile, ... and :suffixes)
    pnpm --filter admin test
    turbo run build
    node --test "src/**/*.test.ts"
    playwright test       (also storybook build, expo run:android, cdk synth, knip)
    cargo test --lib
    CGO_ENABLED=0 go test ./...
    nix develop --command cargo build
    ./gradlew build

Allowed:
    capped npx eslint .
    CGO_ENABLED=0 capped go test ./...
    timeout 600 capped ./gradlew --no-daemon build
    eslint --version

Exit 2 blocks the tool call; stderr goes back to Claude.
Escape hatch for the user only: CLAUDE_CAPPED=0.
"""
import json
import os
import re
import sys

# A command at the start of a segment: line start, or after ; && || | ( or a
# loop keyword. Mirrors the sibling hooks, so the words inside a heredoc or a
# quoted string are not commands.
SEG = r"(?:^|[;&|(]\s*|\b(?:do|then)\s+)\s*"
# Words that may precede the real command: env assignments, capped itself and
# wrappers that pass the rest of the line through.
PREFIX = (
    r"(?P<prefix>(?:(?:[A-Za-z_]\w*=\S*|capped|time|nice(?:\s+-n\s*-?\d+)?"
    r"|timeout\s+\S+|nix\s+develop\b[^;&|\n]*?--command)\s+)*)"
)
HEAVY = (
    r"(?:"
    # Node tools, bare, via a runner or by path (node_modules/.bin/eslint,
    # node .../eslint/bin/eslint.js).
    r"(?:(?:npx|bunx|npm\s+exec|pnpm(?:\s+(?:exec|dlx))?|yarn(?:\s+exec)?)\s+|node\s+(?:-\S+\s+)*)?(?:\S*/)?"
    r"(?:eslint|tsc|vitest|jest|webpack|knip|next\s+(?:build|lint)|vite\s+build"
    r"|playwright\s+test|storybook\s+build|react-scripts\s+(?:build|test)|cypress\s+run"
    r"|expo\s+(?:run|export|prebuild)|expo-module\s+(?:build|test)"
    r"|eas\s+build\b[^;&|\n]*--local|keycloakify\s+build|cdk\s+(?:synth|deploy|diff)"
    r"|turbo(?:\s+-\S+)*\s+(?:run\s+)?(?:build|lint|test|type-?check))\b"
    r"|node\s+(?:-\S+\s+)*--test\b"
    # Package scripts that build, lint or test. Flags that take a value
    # (--filter admin, -C ./api) may sit before the script name.
    r"|(?:npm|pnpm|yarn|bun)(?:\s+(?:--?(?:filter|prefix|workspace|dir)|-[CFw])(?:\s+|=)\S+|\s+-\S+)*"
    r"\s+(?:run\s+)?(?:lint|test|build|types?-?check|check|coverage|knip|synth|compile"
    r"|jest|eslint|e2e|contract-test)(?![\w-])"
    r"|cargo\s+(?:\+\S+\s+)?(?:build|test|check|clippy|run|nextest|bench)\b"
    r"|go\s+(?:build|test|vet|run|install)\b"
    r"|golangci-lint\s+run\b"
    r"|\S*(?:gradlew|grailsw)\b|mvnw?\b|grails\s+(?:test-app|war|compile)\b"
    r")"
)
# Text that is data, not commands: heredoc bodies and quoted strings. Without
# this, editing this very file (or grepping for 'eslint|tsc') trips the hook.
HEREDOC = re.compile(r"<<-?\s*(['\"]?)(\w+)\1[^\n]*\n.*?^\s*\2\s*$", re.MULTILINE | re.DOTALL)
QUOTED = re.compile(r"'[^']*'|\"(?:\\.|[^\"\\])*\"")
CMD = re.compile(SEG + PREFIX + r"(?P<cmd>" + HEAVY + r")[^;&|\n]*", re.MULTILINE)
HARMLESS = re.compile(r"\s--?(?:version|help|v|h)\b")

GUIDANCE = """Wrap it in capped, which binds CPU, memory and cores so the desktop stays usable:

    capped npx eslint .
    CGO_ENABLED=0 capped go test ./...
    capped ./gradlew --no-daemon build

Env assignments go before capped; capped inherits them.
User escape hatch: CLAUDE_CAPPED=0."""


def uncapped(command):
    command = QUOTED.sub("''", HEREDOC.sub("", command))
    for m in CMD.finditer(command):
        if re.search(r"\bcapped\b", m.group("prefix")):
            continue
        if HARMLESS.search(m.group(0)):
            continue
        return m.group("cmd").strip()
    return None


def main():
    if os.environ.get("CLAUDE_CAPPED") == "0":
        return
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return  # fail open on anything unparseable, like the sibling hooks
    if payload.get("tool_name") != "Bash":
        return
    hit = uncapped((payload.get("tool_input") or {}).get("command") or "")
    if hit:
        print(f"[claude-capped-hook]: `{hit}` runs without capped.", file=sys.stderr)
        print(GUIDANCE, file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
