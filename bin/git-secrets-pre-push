#!/usr/bin/env bash
# pre-push hook for the dotfiles clone — refuses to publish a credential or a
# private-network address.
#
# This repo is public, and since 2026-09-13 it carries ~/.claude/CLAUDE.md,
# which is appended to by hand and by Claude whenever a machine or toolchain
# trap is learned. The push is the moment the content becomes public, and it is
# the only moment every path in reaches: an editor, a Claude session and a
# script all end up here, where a PreToolUse hook would only see one of them.
#
# It matches shapes, not meaning. A pasted key or an internal address is
# caught; an unreleased feature described in prose is not, and nothing cheap
# would catch that. No name list to maintain, by choice: a denylist of
# employers and customers publishes the very names it protects, and rots.
#
# Bypass with --no-verify when a match is a false positive; it prints what it
# matched and where, so that is a judgement and not a shrug.
set -uo pipefail

zero=0000000000000000000000000000000000000000

patterns=(
  'ghp_[A-Za-z0-9]{20,}'                       # GitHub personal access token
  'github_pat_[A-Za-z0-9_]{20,}'               # GitHub fine-grained token
  'sk-ant-[A-Za-z0-9_-]{20,}'                  # Anthropic API key
  '(AKIA|ASIA)[0-9A-Z]{16}'                    # AWS access key id
  'xox[baprs]-[A-Za-z0-9-]{10,}'               # Slack token
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'         # any private key
)
# Only credential shapes survived a check against this repo's own content.
# Three candidates were dropped for false positives it generates honestly:
# RFC1918 addresses and internal hostnames (learn/index.html is a networking
# tutorial, full of 192.168.x, host.docker.internal and internal.corp; a home
# router IP discloses nothing anyway), and paths under ~/p/m (p-launcher's
# tests use /home/x/p/m/dependabot as a fixture). Separating a work path from a
# test fixture needs the project names - the name list this deliberately does
# not keep. So: a secret scanner, not a work-context scanner. Say so rather
# than let it read as more coverage than it has.
joined=$(IFS='|'; echo "${patterns[*]}")

fail=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue      # deleting a branch pushes nothing

  if [ "$remote_sha" = "$zero" ]; then
    # new branch: everything not already on some other remote branch
    range=$(git rev-list "$local_sha" --not --remotes | tail -1)
    [ -n "$range" ] && range="$range^..$local_sha" || range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  # -c diff.external= --no-ext-diff is load-bearing, not belt-and-braces: this
  # machine configures difftastic as the external diff driver, and its output
  # carries no "+" prefixes, so the scan below matched nothing and the hook
  # exited 0 on a planted key. A guard that always passes is worse than none.
  #
  # added lines only: an existing match being moved is not a new disclosure
  hits=$(git -c diff.external= diff --no-ext-diff --unified=0 "$range" 2>/dev/null \
    | grep -E '^\+' | grep -v '^+++' \
    | grep -nE "$joined") || continue

  if [ -n "$hits" ]; then
    fail=1
    echo "pre-push: refusing to publish, this looks like it should not be public:" >&2
    echo "$hits" | head -20 | sed 's/^/  /' >&2
  fi
done

if [ "$fail" -ne 0 ]; then
  echo >&2
  echo "  Fix the content, or push with --no-verify if it is a false positive." >&2
  exit 1
fi
exit 0
