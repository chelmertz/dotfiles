#!/usr/bin/env perl
#
# Copyright 2014 Pierre Mavro <deimos@deimos.fr>
# Copyright 2014 Vivien Didelot <vivien@didelot.org>
#
# Licensed under the terms of the GNU GPL v3, or any later version.
#
# This script is meant to use with i3blocks. It parses the output of the "acpi"
# command (often provided by a package of the same name) to read the status of
# the battery, and eventually its remaining time (to full charge or discharge).
#
# The text turns red below 15% (through i3blocks-color), and the urgency
# (exit code 33) is set if there is less that 5% remaining.

use strict;
use warnings;
use utf8;
binmode(STDOUT, ':encoding(UTF-8)');

my $acpi;
my $status;
my $percent;
my $full_text;
my $short_text;
my $bat_number = $ENV{BLOCK_INSTANCE} || 0;

# read the first line of the "acpi" command output
open (ACPI, "acpi -b | grep 'Battery $bat_number' |") or die;
$acpi = <ACPI>;
close(ACPI);

# fail on unexpected output. The status can be two words: a ThinkPad reports
# "Not charging" whenever firmware holds the battery below full, which the
# single-word pattern rejected — a die per refresh, 59 in one boot on tau,
# exiting with perl's errno (29) rather than anything i3blocks could read.
if ($acpi !~ /: ([\w ]+), (\d+)%/) {
	die "$acpi\n";
}

$status = $1;
$percent = $2;

# font awesome battery glyphs by quarter: f244 empty .. f240 full; f0e7 bolt
my $glyph = $percent > 87 ? "\x{f240}"
          : $percent > 62 ? "\x{f241}"
          : $percent > 37 ? "\x{f242}"
          : $percent > 12 ? "\x{f243}"
          :                 "\x{f244}";
$glyph = "\x{f0e7}" if $status eq 'Charging';
$full_text = "$glyph $percent%";

if ($status eq 'Full') {
	# don't print anything when full, the status quo when laptop is "stationary"
	exit(0);
}

$short_text = $full_text;

if ($acpi =~ /(\d\d:\d\d):/) {
	$full_text .= " ($1)";
}

# print text
print "$full_text\n";
print "$short_text\n";

# consider color and urgent flag only on discharge
if ($status eq 'Discharging') {
	if ($percent < 15) {
		system('i3blocks-color', 'red');
	}

	if ($percent < 5) {
		exit(33);
	}
}

exit(0);
