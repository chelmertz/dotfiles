+THREADS_VIEW_LIMIT = 50
+
+
+def handle_threads_view(response_json, eventrouter, team, channel, metadata):
+    # Opens each thread with unread replies and puts it on the hotlist, so
+    # Alt+A reaches it; leaving its buffer marks it read in Slack. The call
+    # is the Slack apps' own, not a published one: if it fails, say so where
+    # wee counts startup errors rather than show nothing.
+    if not response_json.get("ok"):
+        w.prnt(
+            "",
+            "ERROR: could not list unread threads for {} ({}); check the "
+            "Threads view in the Slack app".format(
+                team.domain, response_json.get("error")
+            ),
+        )
+        return
+    for thread in response_json.get("threads", []):
+        root = thread.get("root_msg", {})
+        parent = team.channels.get(root.get("channel"))
+        if not thread.get("unread_replies") or not parent or "ts" not in root:
+            continue
+        process_message(root, eventrouter, team, parent, {}, history_message=True)
+        message = parent.messages.get(SlackTS(root["ts"]))
+        if message is None:
+            continue
+        message.open_thread()
+        if message.thread_channel:
+            message.thread_channel.unread_on_open = True
+    if response_json.get("has_more"):
+        w.prnt(
+            team.channel_buffer,
+            "More than {} threads have unread replies; the rest are in the "
+            "Slack app".format(THREADS_VIEW_LIMIT),
+        )
+
+
