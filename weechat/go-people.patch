+def go_open(buf, entry):
+    """Switch to a buffer, or open the DM for a person."""
+    if entry.get('query'):
+        weechat.command(entry['query'][0], '/query ' + entry['query'][1])
+    else:
+        weechat.command(buf, '/buffer ' + str(entry['full_name']))
