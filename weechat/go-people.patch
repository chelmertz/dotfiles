+def go_people():
+    """(buffer, name) pairs from the people_info info, cached per /go."""
+    global people
+    if people is None:
+        lines = weechat.info_get(weechat.config_get_plugin('people_info'), '')
+        people = [tuple(line.split('\t', 1)) for line in (lines or '').split('\n')
+                  if '\t' in line]
+    return people
+
