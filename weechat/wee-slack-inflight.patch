 ###### New Local Processors
 
+# Every request is a forked weechat process. Uncapped, connecting queues one
+# per conversation and ~400 run at once, enough to exhaust file descriptors.
+# At 8, a cold start sat at the cap for 90 s; Slack's 429s are retried.
+MAX_INFLIGHT_HTTP = 16
+
+
+def is_foreground(obj):
+    # What the user is waiting on skips the connect backlog (~700 queued and
+    # ~700 waiting for a slot, measured): their own /query, requests for and
+    # replies about the buffer on screen, and websocket events, which are
+    # live messages and few.
+    if isinstance(obj, SlackRequest):
+        request = obj
+    elif isinstance(obj, dict):
+        request = obj.get("wee_slack_request_metadata")
+        if request is None:
+            return True
+    else:
+        return False
+    if request.metadata.get("switch"):
+        return True
+    buffer = getattr(request.channel, "channel_buffer", None)
+    return bool(buffer) and buffer == w.current_buffer()
+
+
+def next_waiting(waiting):
+    # A request queued before its buffer was opened (an unread DM's history,
+    # say) is foreground by the time a slot frees: take it first.
+    for i, request in enumerate(waiting):
+        if is_foreground(request):
+            return i
+    return 0
+
+
+def open_request_log():
+    # One line per finished request, rewritten every start, so the time a
+    # load takes can be split into queueing and network.
+    path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "wee-requests.log")
+    try:
+        log = open(path, "w", buffering=1)
+    except OSError:
+        return None
+    log.write(
+        "end request channel code queued_s net_s inflight waiting queue limit origin\n"
+    )
+    return log
+
+
+def log_request(router, request, return_code):
+    if not router.http_log:
+        return
+    now = time.time()
+    sent = getattr(request, "sent_at", now)
+    router.http_log.write("%.3f %s %s %s %.3f %.3f %d %d %d %s %s\n" % (
+        now, request.request, request.post_data.get("channel", "-"), return_code,
+        sent - request.start_time, now - sent, router.http_inflight,
+        len(router.http_waiting), len(router.queue),
+        request.post_data.get("limit", "-"), getattr(request, "origin", "-")))
+
 
