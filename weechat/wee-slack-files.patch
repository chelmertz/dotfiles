+def fetch_file_info(message, file_id):
+    file_info[file_id] = None
+    message.channel.eventrouter.receive(
+        SlackRequest(
+            message.team,
+            "files.info",
+            {"file": file_id},
+            channel=message.channel,
+            metadata={"file": file_id, "ts": message.ts},
+        )
+    )
+
+
+def handle_filesinfo(json, eventrouter, team, channel, metadata):
+    file_info[metadata["file"]] = json["file"] if json["ok"] else {}
+    channel.change_message(metadata["ts"])
