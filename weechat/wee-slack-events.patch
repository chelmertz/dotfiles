+def log_event(kind, channel, detail):
+    # Message-level trail next to wee-requests.log: what happened to each
+    # live message (stored? printed?) and every history load and reprint,
+    # so a message that vanishes shows where. No message text.
+    if not EVENT_LOG:
+        path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "wee-events.log")
+        try:
+            EVENT_LOG.append(open(path, "w", buffering=1))
+        except OSError:
+            EVENT_LOG.append(None)
+    if EVENT_LOG[0]:
+        EVENT_LOG[0].write("%.3f %s %s %s\n" % (
+            time.time(), kind, getattr(channel, "identifier", "-"), detail))
+
