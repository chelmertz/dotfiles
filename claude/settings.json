{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude-diary-hook"
          },
          {
            "type": "command",
            "command": "p-launcher hook",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "claude-terse-git-hook"
          },
          {
            "type": "command",
            "command": "claude-sign-comments-hook"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "p-launcher hook",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "notify-send 'Claude Code' 'Awaiting permission' --expire-time=10000"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "p-launcher hook",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p-launcher hook",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p-launcher hook",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p-launcher hook",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p-launcher hook",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p-launcher hook",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  },
  "theme": "light-daltonized",
  "tui": "fullscreen",
  "editorMode": "vim",
  "effortLevel": "high",
  "preferredNotifChannel": "notifications_disabled",
  "statusLine": {
    "type": "command",
    "command": "/home/ch/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "product-management@knowledge-work-plugins": true
  },
  "extraKnownMarketplaces": {
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    }
  },
  "skillOverrides": {
    "superpowers:writing-plans": "user-invocable-only",
    "superpowers:executing-plans": "user-invocable-only"
  }
}
