{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude-diary-hook"
          },
          {
            "type": "command",
            "command": "p-launcher hook",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "claude-terse-git-hook"
          },
          {
            "type": "command",
            "command": "claude-sign-comments-hook"
          },
          {
            "type": "command",
            "command": "claude-pr-status-hook"
          },
          {
            "type": "command",
            "command": "claude-no-poll-hook"
          },
          {
            "type": "command",
            "command": "claude-security-gate-hook"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "p-launcher hook",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "notify-send --app-name=Claude --expire-time=10000 'Awaiting permission' \"$(jq -r '.cwd // empty' | sed \"s|^$HOME|~|\")\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "p-launcher hook",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p-launcher hook",
            "async": true,
            "timeout": 10
          },
          {
            "type": "command",
            "command": "p-launcher session-brief",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "command -v direnv >/dev/null && [ -n \"$CLAUDE_ENV_FILE\" ] && direnv export bash > \"$CLAUDE_ENV_FILE\" 2>/dev/null; true",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p-launcher hook",
            "async": true,
            "timeout": 10
          },
          {
            "type": "command",
            "command": "p-workspace-commit",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p-launcher hook",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p-launcher hook",
            "async": true,
            "timeout": 10
          },
          {
            "type": "command",
            "command": "p-workspace-commit",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p-launcher hook",
            "async": true,
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "claude-security-gate-hook"
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v direnv >/dev/null && [ -n \"$CLAUDE_ENV_FILE\" ] && direnv export bash > \"$CLAUDE_ENV_FILE\" 2>/dev/null; true",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "attribution": {
    "sessionUrl": false
  },
  "cleanupPeriodDays": 90,
  "theme": "custom:scheme",
  "outputStyle": "Terse",
  "tui": "fullscreen",
  "editorMode": "vim",
  "effortLevel": "high",
  "preferredNotifChannel": "notifications_disabled",
  "statusLine": {
    "type": "command",
    "command": "/home/ch/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "product-management@knowledge-work-plugins": false
  },
  "extraKnownMarketplaces": {
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    }
  },
  "skillOverrides": {
    "superpowers:writing-plans": "user-invocable-only",
    "superpowers:executing-plans": "user-invocable-only"
  },
  "autoCompactWindow": "500k",
  "terminalProgressBarEnabled": true
}
