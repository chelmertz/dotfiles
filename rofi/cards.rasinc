/* Shared layout for the cards themes. Colours come from the importing file:
   bg fg muted border field selected accent red. Matches the dunst cards.
   The window radius is substituted from cardRadius in nix/home.nix. */
* {
    font:             "Inter 18";
    background-color: transparent;
    text-color:       @fg;
    spacing:          0;
}
window {
    location:         center;
    anchor:           center;
    y-offset:         -140px;
    width:            640px;
    background-color: @bg;
    border:           1px;
    border-color:     @border;
    border-radius:    @radius@; /* cardRadius in nix/home.nix */
    padding:          8px;
}
mainbox {
    children: [ inputbar, message, listview, mode-switcher ];
    spacing:  6px;
}
inputbar {
    children:         [ prompt, entry ];
    /* Left padding = element padding (14) + icon (24) + element spacing (12),
       so the prompt lines up with the name column rather than the icon
       gutter. All three are pixels on purpose: an em-sized icon moved with
       the font and the columns drifted apart. */
    padding:          10px 14px 10px 50px;
    spacing:          10px;
    background-color: @field;
    border-radius:    10px;
}
prompt {
    text-color: @muted;
}
entry {
    placeholder:       "Search";
    placeholder-color: @muted;
    cursor:            text;
}
message {
    padding: 6px 14px 6px 50px;
}
textbox {
    text-color: @muted;
}
listview {
    lines:        15; /* projects + the two docked rows should fit without scrolling;
                         Alt+a / Alt+r reach them regardless */
    fixed-height: false;
    scrollbar:    true;
    spacing:      2px;
    padding:      4px 0 0 0;
}
element {
    padding:       10px 14px;
    spacing:       12px;
    border-radius: 10px;
    cursor:        pointer;
}
element-text {
    text-color: inherit;
    cursor:     inherit;
    /* two-line rows (-eh 2, description subtitle): keep single-line text
       centred next to the icon instead of hugging the top */
    vertical-align: 0.5;
    /* Column stop for tab-separated rows (p-launcher/rows.go): name, label.
       The state is the row icon (p-launcher writes them, -show-icons). */
    tab-stops:  [ 270px ];
}
element-icon {
    size:   24px; /* matches the inputbar/message left padding above */
    cursor: inherit;
}
element normal.normal, element alternate.normal { text-color: @fg; }
element selected.normal { background-color: @selected; text-color: @fg; }
element normal.urgent, element alternate.urgent { text-color: @red; }
element selected.urgent { background-color: @red; text-color: @bg; }
element normal.active, element alternate.active { text-color: @accent; }
element selected.active { background-color: @selected; text-color: @accent; }
scrollbar {
    handle-width: 4px;
    handle-color: @border;
    padding:      0 0 0 6px;
}
mode-switcher {
    spacing: 4px;
    padding: 4px 0 0 0;
}
button {
    padding:       8px 12px;
    border-radius: 8px;
    text-color:    @muted;
    cursor:        pointer;
}
button selected {
    background-color: @selected;
    text-color:       @fg;
}
