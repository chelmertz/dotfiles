#!/usr/bin/env bash
# Pretends every PR is still open, so a replay of a merged PR reaches decide.
# Read-only calls only: anything but "gh api" without -X, --input or a mutation is refused.
here=$(cd "$(dirname "$0")" && pwd)
real=$(PATH=$(printf %s "$PATH" | tr : '\n' | grep -vxF "$here" | paste -sd:) command -v gh)
[ "$1" = api ] || { echo "replay gh: refused $*" >&2; exit 1; }
for a in "$@"; do case "$a" in -X|--method|--input|*mutation*) echo "replay gh: refused $*" >&2; exit 1;; esac; done
if [[ "$2" =~ ^repos/[^/]+/[^/]+/pulls/[0-9]+$ ]]; then
  "$real" "$@" | jq -c '.state="open" | .merged=false'
else
  exec "$real" "$@"
fi
